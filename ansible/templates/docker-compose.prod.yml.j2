{#
  As imagens chegam por digest (repo@sha256:...), vindas do job publish. É o que
  garante que o servidor roda exatamente os bytes que passaram nos
  testes — uma tag poderia ser reapontada entre um deploy e outro.

  Os nomes de projeto/volume derivam de app_dir.
#}
services:
  frontend:
    image: "{{ frontend_image }}"
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
{% if mem_limit_frontend is defined %}
    mem_limit: "{{ mem_limit_frontend }}"
{% endif %}
    depends_on:
      - backend
    ports:
      - "127.0.0.1:{{ frontend_port }}:5173"

  backend:
    image: "{{ backend_image }}"
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
{% if mem_limit_backend is defined %}
    # Teto de memória opcional (mem_limit_* no inventário): o servidor divide a
    # VM do WSL com a distro de desenvolvimento e com outros projetos.
    mem_limit: "{{ mem_limit_backend }}"
{% endif %}
    environment:
{% if go_mem_limit_backend is defined %}
      # O Go não enxerga o teto do container; sem isto ele só coleta lixo
      # quando o heap dobra, e pode esbarrar no teto antes.
      GOMEMLIMIT: "{{ go_mem_limit_backend }}"
{% endif %}
      SERVER_ADDR: ":8080"
      DATABASE_URL: "postgres://{{ postgres_user }}:{{ postgres_password }}@postgres:5432/{{ postgres_db }}?sslmode=disable"
      JWT_SECRET: "{{ jwt_secret }}"
      CORS_ORIGIN: "https://{{ app_domain }}"
      EDITAL_PROCESSOR_URL: "http://edital-processor:8000"
      EDITAL_PROCESSOR_TOKEN: "{{ edital_processor_token }}"
      # O que o /health responde: qual publicação está no ar (ver deploy.yml).
      APP_VERSAO: "{{ app_versao }}"
      APP_DEPLOY: "{{ deploy_pipeline_id | default('') }}"
    depends_on:
      postgres:
        condition: service_healthy

  # Interno — sem porta publicada.
  edital-processor:
    image: "{{ edital_processor_image }}"
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
{% if mem_limit_processor is defined %}
    mem_limit: "{{ mem_limit_processor }}"
{% endif %}
    environment:
      EP_SERVICE_TOKEN: "{{ edital_processor_token }}"
      EP_GEMINI_API_KEY: "{{ gemini_api_key | default('') }}"
    volumes:
      - edital_work:/var/lib/edital-processor/work
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/healthz').status==200 else 1)"]
      interval: 15s
      timeout: 5s
      retries: 3

  worker:
    image: "{{ backend_image }}"
    entrypoint: ["/worker"]
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
{% if mem_limit_worker is defined %}
    mem_limit: "{{ mem_limit_worker }}"
{% endif %}
    environment:
{% if go_mem_limit_worker is defined %}
      GOMEMLIMIT: "{{ go_mem_limit_worker }}"
{% endif %}
      DATABASE_URL: "postgres://{{ postgres_user }}:{{ postgres_password }}@postgres:5432/{{ postgres_db }}?sslmode=disable"
      JWT_SECRET: "{{ jwt_secret }}"
      # Sem intervalo fixo: no servidor o worker acorda na virada do dia, que
      # é quando o replanejamento precisa acontecer. Definir lembrete_intervalo
      # volta ao modo de intervalo — útil só para depurar.
{% if lembrete_intervalo is defined %}
      LEMBRETE_INTERVALO: "{{ lembrete_intervalo }}"
{% endif %}
    depends_on:
      postgres:
        condition: service_healthy

  postgres:
    image: postgres:18-alpine
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
{% if mem_limit_postgres is defined %}
    mem_limit: "{{ mem_limit_postgres }}"
{% endif %}
{% if postgres_args is defined %}
    # Ajuste para um banco pequeno numa máquina dividida (postgres_args no
    # inventário): o padrão do Postgres reserva memória para um servidor
    # dedicado.
    command: ["postgres"{% for a in postgres_args %}, "-c", "{{ a }}"{% endfor %}]
{% endif %}
    environment:
      POSTGRES_USER: "{{ postgres_user }}"
      POSTGRES_PASSWORD: "{{ postgres_password }}"
      POSTGRES_DB: "{{ postgres_db }}"
    volumes:
      - postgres_data:/var/lib/postgresql
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ postgres_user }}"]
      interval: 5s
      timeout: 5s
      retries: 5

volumes:
  postgres_data:
  edital_work:
