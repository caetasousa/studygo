---
letsencrypt_email: "you@example.com"

# Long random string used to sign access tokens. Generate with:
#   openssl rand -base64 48
jwt_secret: "CHANGE-ME"

# Password for the production Postgres role.
postgres_password: "CHANGE-ME"

# Optional: Google Gemini API key to enable "import concurso from the edital PDF".
# Leave empty to disable that feature (users cadastram manually). Get a key at
# https://aistudio.google.com/apikey
# Read by the edital-processor container, not the backend.
gemini_api_key: ""
# Shared secret the backend presents to the processor over the compose network.
edital_processor_token: "troque-por-uma-string-longa-e-aleatoria"

# Contas que importam, revisam e publicam provas no catálogo: UUIDs de usuários,
# separados por vírgula. Vazio desliga a curadoria (a consulta continua). Fica
# aqui, fora do main.yml versionado, porque o repositório é público.
#   docker compose exec postgres psql -U <user> <db> -c "select id, email from usuarios"
provas_curadores: ""
