---
# Modelo do secrets.yml do servidor. O real é cifrado com Ansible Vault, não é
# versionado, e a esteira o recebe pela variável ANSIBLE_SECRETS do GitLab.

# Assina os access tokens. Gere com: openssl rand -base64 48
jwt_secret: "CHANGE-ME"

# Senha do papel do Postgres do projeto.
postgres_password: "CHANGE-ME"

# Opcional: chave do Google Gemini para "importar o concurso a partir do PDF do
# edital". Vazia, o cadastro é manual. Lida pelo edital-processor, não pelo
# backend. https://aistudio.google.com/apikey
gemini_api_key: ""
# Segredo que o backend apresenta ao processador na rede do compose.
edital_processor_token: "troque-por-uma-string-longa-e-aleatoria"

# Opcional: token do túnel da Cloudflare, para um domínio próprio
# (docs/cloudflare-tunnel.md). Usado só pelo site.yml, não pelo deploy.
cloudflared_token: ""
