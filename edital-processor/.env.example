# edital-processor — internal service configuration (prefix EP_)
# The Go backend is the only caller; this service is never exposed publicly.

# Shared secret the Go backend presents on every internal call. Required in
# every deployed environment. Leave empty ONLY for local unit runs.
EP_SERVICE_TOKEN=

# Gemini — moved here from the Go container. The service extracts, OCRs and
# chunks locally, then sends only the relevant blocks.
EP_GEMINI_API_KEY=
# EP_GEMINI_MODELS is a comma-free tuple in code; override individual limits as needed.
EP_GEMINI_TIMEOUT_SECONDS=90
EP_GEMINI_MAX_ATTEMPTS=4

# Upload / PDF guards
EP_MAX_UPLOAD_BYTES=26214400
EP_MAX_PAGES=80
EP_MAX_PIXELS_PER_PAGE=40000000

# Text quality / OCR
EP_MIN_TEXT_SCORE=0.55
EP_MIN_TEXT_CHARS=40
EP_OCR_LANGUAGE=por
EP_OCR_DPI=300
EP_OCR_TIMEOUT_SECONDS=40
EP_OCR_MAX_CONCURRENCY=2

# Temporary artifacts
EP_WORK_DIR=/var/lib/edital-processor/work
EP_ARTIFACT_TTL_SECONDS=3600

# Ops
EP_DEBUG_ENDPOINT_ENABLED=false
