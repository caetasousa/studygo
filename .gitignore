# Local env files — only *.example is tracked
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
*.swp

# Real edital PDFs — never commit to the public repo (only synthetic fixtures)
*.pdf

# Per-machine MCP server config
.mcp.json

# Cobertura gerada pelos testes do backend
backend/coverage.out
backend/cover.html

# Suíte E2E: dependências e o relatório de cada execução
e2e/node_modules/
e2e/relatorio/

# Leis: sobras da captura pela linha de comando, que saiu em 26/09/2026 — o
# original baixado e os pacotes. Hoje a captura é pela tela.
conteudo/leis/*/original.*
conteudo/leis/pacotes/

# Permissões locais do Claude Code (as skills em .claude/skills são versionadas)
.claude/settings.local.json
