# Ambiente do stack de E2E (docker compose -p studygo-e2e --env-file e2e/stack.env).
#
# Substitui o .env da raiz de propósito: o E2E não pode herdar a chave do Gemini,
# o banco nem as portas de quem desenvolve. Nada aqui é segredo — o JWT_SECRET
# só assina tokens de um banco que nasce e morre a cada execução.

FRONTEND_PORT=25173
SERVER_PORT=28080
POSTGRES_PORT=25432

POSTGRES_USER=e2e
POSTGRES_PASSWORD=e2e
POSTGRES_DB=e2e

JWT_SECRET=e2e-segredo-descartavel-de-um-banco-que-morre-no-fim

# Sem chave: a importação do edital pela IA fica indisponível, e é isso que o
# E2E confere — o caminho manual não pode depender dela.
GEMINI_API_KEY=
EDITAL_PROCESSOR_TOKEN=e2e-processor-token

LEMBRETE_INTERVALO=24h

# A conta que importa leis. Os testes do grupo L a criam (ou entram nela) com
# este e-mail; as outras contas do E2E não importam, e o L4 confere isso.
LEIS_CURADORES=curadoria@e2e.local
