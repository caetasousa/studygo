# processador — internal service configuration (prefix PROCESSADOR_)
# The Go backend is the only caller; this service is never exposed publicly.

# Shared secret the Go backend presents on every internal call. Required in
# every deployed environment. Leave empty ONLY for local unit runs.
PROCESSADOR_SERVICE_TOKEN=

# Gemini — moved here from the Go container. The service extracts, OCRs and
# chunks locally, then sends only the relevant blocks.
PROCESSADOR_GEMINI_API_KEY=
# PROCESSADOR_GEMINI_MODELS is a comma-free tuple in code; override individual limits as needed.
PROCESSADOR_GEMINI_TIMEOUT_SECONDS=90
PROCESSADOR_GEMINI_MAX_ATTEMPTS=4

# Upload / PDF guards
PROCESSADOR_MAX_UPLOAD_BYTES=26214400
PROCESSADOR_MAX_PAGES=80
PROCESSADOR_MAX_PIXELS_PER_PAGE=40000000

# Text quality / OCR
PROCESSADOR_MIN_TEXT_SCORE=0.55
PROCESSADOR_MIN_TEXT_CHARS=40
PROCESSADOR_OCR_LANGUAGE=por
PROCESSADOR_OCR_DPI=300
PROCESSADOR_OCR_TIMEOUT_SECONDS=40
PROCESSADOR_OCR_MAX_CONCURRENCY=2

# Temporary artifacts
PROCESSADOR_WORK_DIR=/var/lib/processador/work
PROCESSADOR_ARTIFACT_TTL_SECONDS=3600

# Ops
PROCESSADOR_DEBUG_ENDPOINT_ENABLED=false
