# Copy to .env and adjust. Only JWT_SECRET is required.

SERVER_PORT=8080
FRONTEND_PORT=5173

POSTGRES_USER=annygo
POSTGRES_PASSWORD=annygo
POSTGRES_DB=annygo
POSTGRES_PORT=5432

# Sign key for access tokens — use a long random string in any real deployment.
JWT_SECRET=troque-por-uma-string-longa-e-aleatoria

# Browser origin allowed to call the API directly (only matters if the SPA is
# served from a different origin than the API; with the bundled frontend proxy
# it can stay as-is).
CORS_ORIGIN=http://localhost:5173

# How often the reminder worker recomputes the spaced-review digest.
LEMBRETE_INTERVALO=24h

# --- edital import (optional) ---
# The edital PDF -> reviewable preview pipeline runs in the internal
# edital-processor service. Leave GEMINI_API_KEY blank and users just register
# concursos by hand; the rest of the app is unaffected.
#
# Google Gemini API key — read by the processor, not the backend.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Shared secret the backend presents to the processor over the compose network.
# Change it for any real deployment.
EDITAL_PROCESSOR_TOKEN=dev-processor-token
# Where the backend reaches the processor. The compose default is fine; only set
# this to run the processor elsewhere.
# EDITAL_PROCESSOR_URL=http://edital-processor:8000
